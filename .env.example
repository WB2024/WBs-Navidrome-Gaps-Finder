# ──────────────────────────────────────────────────────────────────────────────
# Last.fm API Configuration (required for Artist Similarity Finder)
# ──────────────────────────────────────────────────────────────────────────────
#
# 1. Create a Last.fm API account at: https://www.last.fm/api/account/create
#    - Contact email:        your email address
#    - Application name:     e.g. "Navidrome Gaps Finder"
#    - Application description: e.g. "Finding similar artists for my music library"
#    - Callback URL:         (leave blank — not needed)
#    - Application homepage: (leave blank — not needed)
#
# 2. After submitting, you will receive an API Key and a Shared Secret.
#    Only the API Key is needed here.
#
# 3. Copy this file to .env and fill in your API key:
#      cp .env.example .env
#
# ──────────────────────────────────────────────────────────────────────────────

LASTFM_API_KEY=your_api_key_here

# ──────────────────────────────────────────────────────────────────────────────
# SSH Configuration (required for remote Nicotine+ integration)
# ──────────────────────────────────────────────────────────────────────────────
#
# If your Nicotine+ instance runs on a remote server (e.g. a NAS), the app
# can connect via SSH to update the wishlist and restart the Docker container.
#
# Set your SSH password here. If you use SSH key authentication instead,
# you can leave this blank and specify the key path in the app (press 'n').
#
# ──────────────────────────────────────────────────────────────────────────────

SSH_PASSWORD=
